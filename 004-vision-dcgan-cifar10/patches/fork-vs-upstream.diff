@@ -0,0 +1,44 @@
+name: dcgan-cifar10 reproduction
+
+# Generated by scaffold_row.py. Clean-DAG rules baked in: every step is a NAMED
+# `roar run -n <name>` (trace:off, same-ABI); outputs live in git-tracked dirs
+# (.gitkeep) with files gitignored; publish --no-tag. Adjust commands as needed.
+
+secrets:
+  - HF_TOKEN            # wandb->trackio sync + roar put upload
+
+setup:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    python -m pip install --quiet requests || true
+    roar --version
+    roar tracer use preload
+    roar tracer
+    roar init || true
+  trace: off
+
+prepare:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    export TRACKIO_SPACE_ID=reproducible-ai/experiments PYTHONUNBUFFERED=1
+    roar run -n prepare --wandb-to-trackio -- python -c "import torch, torchvision, torchvision.datasets as d; print(\"torch\", torch.__version__, \"torchvision\", torchvision.__version__); d.CIFAR10(root=\"cifar10-data\", download=True)"
+  trace: off
+
+train:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    export TRACKIO_SPACE_ID=reproducible-ai/experiments PYTHONUNBUFFERED=1
+    roar run -n train --wandb-to-trackio -- python dcgan/main.py --dataset cifar10 --dataroot cifar10-data --outf out --niter 1 --accel --workers 2 --manualSeed 42
+  trace: off
+
+label:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    roar label set artifact out/netG_epoch_0.pth model.name=dcgan-cifar10 model.version=1 license.id=BSD-3-Clause license.name='BSD 3-Clause License' description='DCGAN (Radford et al. 2015) from pytorch/examples, trained on CIFAR-10. TRUNCATED pipeline-viability run: 1 epoch, NOT converged.' documentation.url=https://github.com/pytorch/examples/blob/main/dcgan/README.md
+  trace: off
+
+publish:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    roar put out/netG_epoch_0.pth hf://reproducible-ai/dcgan --public --yes --no-tag -m "TRUNCATED pipeline-viability run: DCGAN on CIFAR-10, --niter 1 (one epoch, ~782 iters). NOT converged and not a quality result; published to demonstrate end-to-end provenance capture. Re-capture of the row on a plain-PyPI torch image so the recorded pip freeze is portable (no +cuNNN local-version pins)."
+  trace: off
diff --git a/.treqs/workflows/plaintorch-image-audit.yaml b/.treqs/workflows/plaintorch-image-audit.yaml
new file mode 100644
index 0000000000..0b2517e21c
--- /dev/null
+++ b/.treqs/workflows/plaintorch-image-audit.yaml
@@ -0,0 +1,43 @@
+name: plaintorch image audit
+
+# Throwaway pre-flight (NOT a campaign row). Proves the compute target's AMI
+# records a PORTABLE freeze before we spend on a capture: no PyTorch-index
+# local-version tags (`+cuNNN`, absent from PyPI) and no duplicate PEP-503
+# names at different versions. Run with --lineage private; not published.
+
+setup:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    echo "=== python ==="
+    which python; python -V
+    echo "=== roar ==="
+    roar --version
+    echo "=== gpu ==="
+    nvidia-smi || true
+  trace: off
+
+audit:
+  command: |
+    export PATH=/opt/pytorch/bin:$PATH
+    echo "=== TORCH FAMILY (expect plain 2.7.0 / 0.22.0 / 2.7.0) ==="
+    python -c "import torch, torchvision, torchaudio; print('torch', torch.__version__); print('torchvision', torchvision.__version__); print('torchaudio', torchaudio.__version__); print('cuda_available', torch.cuda.is_available())"
+    echo "=== LOCAL-VERSION TAGGED PINS (expect NONE) ==="
+    if python -m pip list --format=freeze | grep '+'; then echo "VERDICT: TAGGED_PINS_FOUND"; else echo "VERDICT: NO_TAGGED_PINS"; fi
+    echo "=== PIN COUNT ==="
+    python -m pip list --format=freeze | wc -l
+    python - <<'PY'
+    import re, subprocess, collections
+    out = subprocess.run(["python", "-m", "pip", "list", "--format=freeze"],
+                         capture_output=True, text=True).stdout
+    names = collections.defaultdict(set)
+    for line in out.splitlines():
+        if "==" in line:
+            n, v = line.split("==", 1)
+            names[re.sub(r"[-_.]+", "-", n).lower()].add(v)
+    dupes = {k: sorted(v) for k, v in names.items() if len(v) > 1}
+    print("=== PEP503 DUPLICATE NAMES (expect none) ===")
+    print("VERDICT: PEP503_DUPES", dupes if dupes else "none")
+    PY
+    echo "=== FULL FREEZE ==="
+    python -m pip list --format=freeze
+  trace: off
