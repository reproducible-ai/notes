+"""Fetch the MNIST dataset used by wgan_gp.py.
+
+[REPRODUCIBLE-AI ADDITION] Not part of upstream eriklindernoren/PyTorch-GAN.
+
+Upstream downloads MNIST as a side effect of constructing the DataLoader inside
+the training script, which makes the fetch invisible to provenance tracking (the
+dataset appears as a file the *training* step happened to write). Splitting the
+fetch into its own step makes the dataset a first-class artifact that the train
+and eval steps consume, so lineage shows fetch -> train -> eval.
+
+Downloads exactly what torchvision's datasets.MNIST would download; it is a
+no-op when the files are already present.
+"""
+
+import argparse
+import os
+
+from torchvision import datasets
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--data_root",
+        type=str,
+        default="../../data/mnist",
+        help="MNIST root dir (must match wgan_gp.py --data_root)",
+    )
+    opt = parser.parse_args()
+
+    os.makedirs(opt.data_root, exist_ok=True)
+    train = datasets.MNIST(opt.data_root, train=True, download=True)
+    test = datasets.MNIST(opt.data_root, train=False, download=True)
+    print("MNIST ready in %s: train=%d test=%d" % (opt.data_root, len(train), len(test)))
+
+
+if __name__ == "__main__":
+    main()
