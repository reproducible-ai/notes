+"""Evaluate a wgan_gp.py checkpoint and write a metrics JSON.
+
+[REPRODUCIBLE-AI ADDITION] Not part of upstream eriklindernoren/PyTorch-GAN.
+
+Upstream computes no metric at all -- it prints the running D/G losses and saves
+image grids. This script loads the checkpoint saved by the modified wgan_gp.py
+and computes, on the MNIST **test** split (never seen during training):
+
+  * mean critic score on real images
+  * mean critic score on generated images
+  * the Wasserstein-distance estimate  E[D(real)] - E[D(fake)]
+  * the WGAN-GP gradient penalty on the evaluation batches
+
+Loading is strict=True on purpose: the architectures below are copies of the
+ones in wgan_gp.py (upstream defines them at module scope alongside the training
+loop, so they cannot be imported without running training). If upstream's
+architecture ever drifts from this copy, load_state_dict fails loudly rather
+than silently evaluating a different model.
+"""
+
+import argparse
+import json
+import os
+
+import numpy as np
+import torch
+import torch.autograd as autograd
+import torch.nn as nn
+import torchvision.transforms as transforms
+from torchvision import datasets
+
+
+# --- architecture: verbatim copy of wgan_gp.py, parameterised instead of using
+# --- the module-level `opt` / `img_shape` globals.
+class Generator(nn.Module):
+    def __init__(self, latent_dim, img_shape):
+        super(Generator, self).__init__()
+        self.img_shape = img_shape
+
+        def block(in_feat, out_feat, normalize=True):
+            layers = [nn.Linear(in_feat, out_feat)]
+            if normalize:
+                layers.append(nn.BatchNorm1d(out_feat, 0.8))
+            layers.append(nn.LeakyReLU(0.2, inplace=True))
+            return layers
+
+        self.model = nn.Sequential(
+            *block(latent_dim, 128, normalize=False),
+            *block(128, 256),
+            *block(256, 512),
+            *block(512, 1024),
+            nn.Linear(1024, int(np.prod(img_shape))),
+            nn.Tanh()
+        )
+
+    def forward(self, z):
+        img = self.model(z)
+        img = img.view(img.shape[0], *self.img_shape)
+        return img
+
+
+class Discriminator(nn.Module):
+    def __init__(self, img_shape):
+        super(Discriminator, self).__init__()
+        self.model = nn.Sequential(
+            nn.Linear(int(np.prod(img_shape)), 512),
+            nn.LeakyReLU(0.2, inplace=True),
+            nn.Linear(512, 256),
+            nn.LeakyReLU(0.2, inplace=True),
+            nn.Linear(256, 1),
+        )
+
+    def forward(self, img):
+        img_flat = img.view(img.shape[0], -1)
+        return self.model(img_flat)
+
+
+def compute_gradient_penalty(D, real_samples, fake_samples, device):
+    """Verbatim from wgan_gp.py, with the global Tensor type made explicit."""
+    alpha = torch.rand(real_samples.size(0), 1, 1, 1, device=device)
+    interpolates = (alpha * real_samples + ((1 - alpha) * fake_samples)).requires_grad_(True)
+    d_interpolates = D(interpolates)
+    fake = torch.ones(real_samples.shape[0], 1, device=device, requires_grad=False)
+    gradients = autograd.grad(
+        outputs=d_interpolates,
+        inputs=interpolates,
+        grad_outputs=fake,
+        create_graph=True,
+        retain_graph=True,
+        only_inputs=True,
+    )[0]
+    gradients = gradients.view(gradients.size(0), -1)
+    return ((gradients.norm(2, dim=1) - 1) ** 2).mean()
+
+
+def load_checkpoint(path):
+    try:
+        return torch.load(path, map_location="cpu", weights_only=True)
+    except TypeError:  # torch < 2.0 has no weights_only kwarg
+        return torch.load(path, map_location="cpu")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--checkpoint", type=str, required=True, help="checkpoint written by wgan_gp.py")
+    parser.add_argument("--data_root", type=str, default="../../data/mnist", help="MNIST root dir")
+    parser.add_argument("--metrics", type=str, required=True, help="path of the metrics JSON to write")
+    parser.add_argument("--batch_size", type=int, default=64)
+    parser.add_argument("--n_batches", type=int, default=50, help="evaluation batches from the test split")
+    parser.add_argument("--seed", type=int, default=42)
+    opt = parser.parse_args()
+
+    torch.manual_seed(opt.seed)
+    np.random.seed(opt.seed)
+    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
+
+    ckpt = load_checkpoint(opt.checkpoint)
+    train_opt = ckpt["opt"]
+    img_shape = tuple(ckpt["img_shape"])
+    latent_dim = int(train_opt["latent_dim"])
+
+    generator = Generator(latent_dim, img_shape).to(device)
+    discriminator = Discriminator(img_shape).to(device)
+    generator.load_state_dict(ckpt["generator"], strict=True)
+    discriminator.load_state_dict(ckpt["discriminator"], strict=True)
+    generator.eval()
+    discriminator.eval()
+
+    dataloader = torch.utils.data.DataLoader(
+        datasets.MNIST(
+            opt.data_root,
+            train=False,
+            download=False,
+            transform=transforms.Compose(
+                [
+                    transforms.Resize(int(train_opt["img_size"])),
+                    transforms.ToTensor(),
+                    transforms.Normalize([0.5], [0.5]),
+                ]
+            ),
+        ),
+        batch_size=opt.batch_size,
+        shuffle=False,
+    )
+
+    real_scores, fake_scores, penalties = [], [], []
+    n_images = 0
+    for i, (imgs, _) in enumerate(dataloader):
+        if i >= opt.n_batches:
+            break
+        real_imgs = imgs.to(device)
+        z = torch.randn(real_imgs.size(0), latent_dim, device=device)
+        with torch.no_grad():
+            fake_imgs = generator(z)
+            real_scores.append(discriminator(real_imgs).mean().item())
+            fake_scores.append(discriminator(fake_imgs).mean().item())
+        penalties.append(
+            compute_gradient_penalty(discriminator, real_imgs, fake_imgs, device).item()
+        )
+        n_images += real_imgs.size(0)
+
+    mean_real = float(np.mean(real_scores))
+    mean_fake = float(np.mean(fake_scores))
+    metrics = {
+        "model": "wgan_gp",
+        "dataset": "mnist-test",
+        "images_evaluated": n_images,
+        "epochs_trained": int(ckpt.get("epochs_trained", train_opt.get("n_epochs", 0))),
+        "batches_done": int(ckpt.get("batches_done", 0)),
+        "critic_score_real_mean": mean_real,
+        "critic_score_fake_mean": mean_fake,
+        "wasserstein_estimate": mean_real - mean_fake,
+        "gradient_penalty_mean": float(np.mean(penalties)),
+        "lambda_gp": float(ckpt.get("lambda_gp", 10)),
+        "generator_parameters": sum(p.numel() for p in generator.parameters()),
+        "discriminator_parameters": sum(p.numel() for p in discriminator.parameters()),
+        "device": device.type,
+        "torch_version": torch.__version__,
+        "truncated_run": True,
+        "note": "Truncated training run; metric values are NOT converged and are "
+        "published only as evidence that the metric is computed end to end.",
+    }
+
+    metrics_dir = os.path.dirname(opt.metrics)
+    if metrics_dir:
+        os.makedirs(metrics_dir, exist_ok=True)
+    with open(opt.metrics, "w") as fh:
+        json.dump(metrics, fh, indent=2, sort_keys=True)
+    print(json.dumps(metrics, indent=2, sort_keys=True))
+    print("Wrote %s" % opt.metrics)
+
+
+if __name__ == "__main__":
+    main()
